{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "quick-search",
  "title": "Quick Search",
  "icon": "icon.png",
  "description": "Perform various actions on the selected text or clipboard text. Translate, paraphrase, or look up a definition etc.",
  "author": "iwfan",
  "license": "MIT",
  "permissions": [
    "clipboard-read",
    "accessibility"
  ],
  "commands": [
    {
      "name": "index",
      "title": "Quick Search",
      "description": "Perform various actions on the selected text or clipboard text. Translate, paraphrase, or look up a definition etc.",
      "mode": "view",
      "arguments": [
        {
          "name": "text",
          "placeholder": "Text",
          "type": "text"
        }
      ]
    }
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.2",
    "@raycast/api": "^1.102.3",
    "@raycast/utils": "^1.17.0",
    "@types/fs-extra": "^11.0.4",
    "fs-extra": "^11.3.1",
    "promptl-ai": "^0.7.5"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
